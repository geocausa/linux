# Combined KUnit configuration for the Apple, Asahi and Aurora suites in
# omacom/linux-aurora (integration/aurora).
#
# Run with tools/testing/kunit/kunit.py run --arch=arm64 (QEMU virt, -cpu max)
# and --make_options LLVM=... . Historical result at 1b4997bbab62:
# 98 suites / 1399 cases (expected: 3 skips, 0 failures).
# Needs a Rust toolchain: the SEP, AOP, T8140 audio and Asahi GPU code is Rust.
# The kernel uses 16K pages and 48-bit VA, as the shipped kernel does:
# PCIE_APPLE (needed by USB4_APPLE_SOC and MT7932) and DRM_ASAHI depend on
# PAGE_SIZE_16KB, and one DART case skips with smaller pages.
# Every option below must survive olddefconfig; kunit.py fails the build if a
# listed option does not end up in .config.

CONFIG_KUNIT=y

# Platform
CONFIG_ARCH_APPLE=y
# CONFIG_ARM64_4K_PAGES is not set
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_PM=y
CONFIG_OF=y
CONFIG_OF_OVERLAY=y
CONFIG_RUST=y

# Rust kernel crate: doctests and unit tests (rust/kernel is used by the
# Apple Rust drivers; the fork changes kvec, xarray, allocator and bitfield)
CONFIG_RUST_KERNEL_DOCTESTS=y
CONFIG_RUST_KUNIT_TESTS=y
CONFIG_RUST_ALLOCATOR_KUNIT_TEST=y
CONFIG_RUST_KVEC_KUNIT_TEST=y
CONFIG_RUST_BITMAP_KUNIT_TEST=y
CONFIG_RUST_KUNIT_SELFTEST=y
CONFIG_RUST_STR_KUNIT_TEST=y
CONFIG_RUST_ATOMICS_KUNIT_TEST=y
CONFIG_RUST_BITFIELD_KUNIT_TEST=y

# Apple SoC core (mailbox, RTKit, PMP; APPLE_PMP selects the Rust RTKit glue)
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_PMP=y
CONFIG_APPLE_AOP=y

# Apple MCC (T8140 system level cache)
CONFIG_APPLE_MCC=y
CONFIG_APPLE_MCC_KUNIT_TEST=y

# Apple SEP (Rust)
CONFIG_SPI=y
CONFIG_HW_RANDOM=y
CONFIG_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_CRYPTO=y
CONFIG_APPLE_SEP=y
CONFIG_APPLE_SEP_KUNIT_TEST=y

# Apple display gate (T6030/T6031/T8122)
CONFIG_APPLE_T6030_DISPLAY_GATE=y
CONFIG_APPLE_DISPLAY_GATE_KUNIT_TEST=y

# Apple PMC / PMP report power domains
CONFIG_APPLE_PMC=y
CONFIG_APPLE_PMC_KUNIT_TEST=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_APPLE_PMP_REPORT_KUNIT_TEST=y
CONFIG_APPLE_PMP_REPORT_START_KUNIT_TEST=y

# Apple DART IOMMU
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_DART_KUNIT_TEST=y

# Apple display controller (DCP) and display fabric
CONFIG_DRM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_APPLE=y
CONFIG_DRM_APPLE_KUNIT_TEST=y
CONFIG_DRM_APPLE_PARSER_KUNIT_TEST=y
CONFIG_DRM_APPLE_DISPLAY_KUNIT_TEST=y
CONFIG_DRM_APPLE_FABRIC_KUNIT_TEST=y

# Asahi GPU (Rust); enables RUST_DRM_GEM_SHMEM_HELPER for the
# rust_drm_gem_shmem suite in rust/kernel/drm/gem/shmem.rs
CONFIG_DRM_ASAHI=y

# Apple Neural Engine
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_ANE=y
CONFIG_DRM_ACCEL_ANE_KUNIT_TEST=y

# Apple video decoder and ISP
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_APPLE_AVD=y
CONFIG_VIDEO_APPLE_AVD_KUNIT_TEST=y
CONFIG_VIDEO_APPLE_ISP=y
CONFIG_VIDEO_APPLE_ISP_KUNIT_TEST=y
CONFIG_VIDEO_APPLE_ISP_IPC_LAYOUT_KUNIT_TEST=y

# PCIe, USB4/Thunderbolt
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEASPM=y
CONFIG_PCIE_APPLE=y
CONFIG_PCI_SYSFS_KUNIT_TEST=y
CONFIG_USB4=y
CONFIG_USB4_KUNIT_TEST=y
CONFIG_USB4_APPLE_SOC=y
CONFIG_USB4_APPLE_DPIN_KUNIT_TEST=y

# Type-C: mux lookup (DT overlay), CD321x (tipd), SN201202x, ATC PHY
CONFIG_USB_SUPPORT=y
CONFIG_TYPEC=y
CONFIG_TYPEC_MUX_KUNIT_TEST=y
CONFIG_I2C=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_TYPEC_TIPD_KUNIT_TEST=y
CONFIG_SPMI=y
CONFIG_TYPEC_SN201202X=y
CONFIG_TYPEC_SN201202X_KUNIT_TEST=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_PHY_APPLE_ATC_KUNIT_TEST=y

# USB core, xHCI platform, DWC3 and the Apple DWC3 glue
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_PORT_POWER_KUNIT_TEST=y
CONFIG_USB_QUIRKS_KUNIT_TEST=y
CONFIG_USB_WAKEUP_KUNIT_TEST=y
CONFIG_USB_XHCI_PLATFORM_KUNIT_TEST=y
CONFIG_USB_DWC3_HOST_KUNIT_TEST=y
CONFIG_USB_DWC3_APPLE_KUNIT_TEST=y

# Apple SMC: core, battery, hwmon
CONFIG_MFD_MACSMC=y
CONFIG_MFD_MACSMC_KUNIT_TEST=y
CONFIG_POWER_SUPPLY=y
CONFIG_MACSMC_POWER=y
CONFIG_MACSMC_POWER_KUNIT_TEST=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON_KUNIT_TEST=y

# DockChannel HID (keyboard/trackpad transport)
CONFIG_INPUT=y
CONFIG_HID=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL_KUNIT_TEST=y
CONFIG_HID_DOCKCHANNEL_PARSER_KUNIT_TEST=y

# Apple QSPI boot NOR write window
CONFIG_SPI_MEM=y
CONFIG_SPI_APPLE_QSPI=y
CONFIG_SPI_APPLE_QSPI_KUNIT_TEST=y

# T8140 AOP audio (Rust)
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_DMADEVICES=y
CONFIG_DMA_ENGINE=y
CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=y

# Cirrus jack codecs: clock switching and playback resume/prepare recovery
# I2C is enabled above; build the codecs in with their real KUnit suites.
CONFIG_SND_SOC_CS42L42=y
CONFIG_SND_SOC_CS42L42_CORE=y
CONFIG_SND_SOC_CS42L42_TEST=y
CONFIG_SND_SOC_CS42L84=y
CONFIG_SND_SOC_CS42L84_TEST=y

# Wireless and Bluetooth: brcmfmac scan timeout, MT7932 (J700)
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_BRCMFMAC_KUNIT_TEST=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_PCIE_APPLE_PIODMA_DIAG=y
CONFIG_MT7932_FULLMAC=y
CONFIG_MT7932_KUNIT_TEST=y
CONFIG_MT7932_RF_KUNIT_TEST=y
CONFIG_BT=y
CONFIG_BT_MTK7932_PCIE=y
CONFIG_BT_MTK7932_PCIE_KUNIT_TEST=y

# kexec blockers, trusted-key source registration, long symbol names
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_BLOCK_KUNIT_TEST=y
CONFIG_TRUSTED_SOURCE_KUNIT_TEST=y
CONFIG_KPROBES=y
CONFIG_LONGEST_SYM_KUNIT_TEST=y
