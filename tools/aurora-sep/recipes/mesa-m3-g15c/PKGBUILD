# Mesa for the M3 Max GPU bring-up (T6031, G15C), in its own prefix,
# /opt/mesa-m3-g15c. It installs beside system Mesa and the M3 Pro's
# /opt/mesa-m3, and nothing uses it except programs started through
# /opt/mesa-m3-g15c/bin/g15c-run (or g15c-first-job), which sets the opt-in
# variables. No session hook, udev rule or user unit.
#
# Source: branch max/g15c-mesa-20261011, commit _commit below: the M3 Pro
# release Mesa (7ff89a4da38, the source of mesa-m3-26.1.4.m3.2-5 in
# aurora-2026.10.11.15) plus four commits:
#   asahi/drm-shim: add a G15C (T6031) profile
#   asahi: describe the T6031 runtime VA ranges in one table
#   asahi, hk, zink: give G15C the G15S runtime choices
#   asahi: admit G15C (T6031) behind ASAHI_M3_G15C
# The tarball is `git archive` of the commit with the prefix mesa-26.1.4/.
#
# The build follows mesa-m3-26.1.4.m3.2-5's legacy profile exactly: the same
# toolchain (SPIRV-Tools, SPIRV-LLVM-Translator and libclc built from the same
# tarballs against LLVM 22), the same Meson options with the prefix moved,
# the plane-layout control, and the qualified M3 Pro kernel files and kernel
# digest, which must still match (the G15C commits do not change them). One
# option is added: -Dtools=drm-shim, so build() can open the built drivers
# against the G15C, G15S and G15G drm-shim profiles. The shim library is not
# packaged. The HAL200 (J613) build, the probes and the session pieces of
# mesa-m3 are left out.
#
# Also built: compute-check (Vulkan compute, every word checked) and gpu-heat
# (GLES load), the M3 Pro's files; vk-render-check and gl-render-check (a clear
# and a draw, every pixel checked, in Vulkan and in GLES through zink); and
# the g15c-run and g15c-first-job scripts. For the M3 Max kit's render job,
# bin/mesa-m3-probe runs the M3 Pro's session probe (mesa-m3-probe.c, the
# release's file, built with its PREFIX set to this prefix) through g15c-run.
#
# Every file is under /opt (the kit installs only such a package), so the
# licences are in /opt/mesa-m3-g15c/share/licenses/mesa-m3-g15c.
pkgname=mesa-m3-g15c
pkgver=26.1.4.g15c1
pkgrel=2
_commit=ff120e88cfc047b69ed412b2276599e3b2a426de
pkgdesc="Mesa in /opt/mesa-m3-g15c for M3 Max (G15C) GPU bring-up: opt-in test prefix (source ${_commit:0:12})"
arch=('aarch64')
url='https://github.com/iconidentify/aurora-linux'
license=('MIT' 'SGI-B-2.0' 'BSL-1.0' 'HPND-sell-variant' 'BSD-3-Clause' 'CC0-1.0 OR Apache-2.0'
         'LicenseRef-MLAA' 'Apache-2.0 WITH LLVM-exception')
